# ── Discussion Hall (Supabase) ────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API).
#
# Public lore browsing works with zero of these set. The Discussion Hall stays
# in its honest "being prepared" state until NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY are present.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon/public key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — SERVER ONLY. Never expose to the browser or ship it into
# client bundles. Used for moderation (hiding rule-breaking content).
SUPABASE_SERVICE_ROLE_KEY=